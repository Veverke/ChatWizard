.vscode/**
.vscode-test/**
.vscode-test.*
src/**
test/**
out/**
docs/**
!docs/user-guide.md
.github/**
.claude/**
.gitignore
.eslintrc.json
tsconfig.json
coverage/**
**/*.map
**/*.ts

node_modules/**

# Keep bundled output and assets
!dist/**
!images/**
!resources/**

# better-sqlite3: include the compiled native addon and its runtime JS wrapper.
# The native binary (better_sqlite3.node) is platform-specific and MUST be compiled
# on the same OS as the target VSIX platform (see scripts/rebuild-native.js).
!node_modules/better-sqlite3/lib/**
!node_modules/better-sqlite3/build/Release/better_sqlite3.node
!node_modules/better-sqlite3/package.json

# @xenova/transformers: loaded externally at runtime (not bundled); include full package
!node_modules/@xenova/transformers/**

# bindings + file-uri-to-path: runtime deps used by better-sqlite3 to locate the .node file
!node_modules/bindings/bindings.js
!node_modules/bindings/package.json
!node_modules/file-uri-to-path/index.js
!node_modules/file-uri-to-path/package.json

# scripts dir: not needed in the extension package
scripts/**

# Temp / debug artifacts — never ship these
temp_commands.txt
chatwizard_tmp.zip
vsix_check/
vsix_tmp/

# --- onnxruntime-node (added by package-vsix.mjs, reverted after packaging) ---
# onnxruntime-node: native ONNX Runtime required by @xenova/transformers.
# Only the current platform's binary is included (9-23 MB per VSIX).
!node_modules/onnxruntime-node/dist/**
!node_modules/onnxruntime-node/package.json
!node_modules/onnxruntime-node/bin/napi-v3/win32/x64/**
# onnxruntime-common: peer dep of onnxruntime-node; required at runtime.
!node_modules/onnxruntime-common/dist/**
!node_modules/onnxruntime-common/package.json

# --- onnxruntime-node (added by package-vsix.mjs, reverted after packaging) ---
# onnxruntime-node: native ONNX Runtime required by @xenova/transformers.
# Only the current platform's binary is included (9-23 MB per VSIX).
!node_modules/onnxruntime-node/dist/**
!node_modules/onnxruntime-node/package.json
!node_modules/onnxruntime-node/bin/napi-v3/win32/x64/**
# onnxruntime-common: peer dep of onnxruntime-node; required at runtime.
!node_modules/onnxruntime-common/dist/**
!node_modules/onnxruntime-common/package.json

# --- onnxruntime-node (added by package-vsix.mjs, reverted after packaging) ---
# onnxruntime-node: native ONNX Runtime required by @xenova/transformers.
# Only the current platform's binary is included (9-23 MB per VSIX).
!node_modules/onnxruntime-node/dist/**
!node_modules/onnxruntime-node/package.json
!node_modules/onnxruntime-node/bin/napi-v3/win32/x64/**
# onnxruntime-common: peer dep of onnxruntime-node; required at runtime.
!node_modules/onnxruntime-common/dist/**
!node_modules/onnxruntime-common/package.json
